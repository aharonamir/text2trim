{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://text2trim.local/contracts/worker-v1.schema.json",
  "title": "Text2Trim Worker API v1 health response",
  "type": "object",
  "required": ["protocol_version", "status", "worker_version", "capabilities"],
  "properties": {
    "protocol_version": {"const": 1},
    "status": {"const": "ready"},
    "worker_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "capabilities": {
      "type": "array",
      "items": {"type": "string"},
      "uniqueItems": true
    }
  },
  "additionalProperties": false
}
